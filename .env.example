# OpenAI-compatible Chat Completions API
# Set LLM_BASE_URL to the provider's /v1 root (not /chat/completions).
LLM_BASE_URL=https://api.openai.com/v1
LLM_API_KEY=replace-me
LLM_MODEL=gpt-4o-mini

# Optional second-pass verifier. If omitted, the generation endpoint/model is reused.
# Use a different model/provider when you want a less correlated check.
# VERIFIER_BASE_URL=https://api.openai.com/v1
# VERIFIER_API_KEY=replace-me
# VERIFIER_MODEL=gpt-4o-mini

# --- Server & security ---------------------------------------------------
# Interface to bind. Default 127.0.0.1 (this machine only). Use 0.0.0.0 only on a
# trusted network — the API has no authentication.
# ANALYZER_HOST=127.0.0.1
# ANALYZER_PORT=8787

# Extra Host header values the API accepts (comma-separated). Needed when you reach
# the server by a hostname other than localhost/127.0.0.1, e.g. in a dev container.
# ALLOWED_HOSTS=heatmap.internal

# Restrict which Chrome extension IDs may call the API (comma-separated).
# Empty = any extension origin.
# ALLOWED_EXTENSION_IDS=

# Max /api/analyze requests per client IP per minute (0 disables the limit).
# RATE_LIMIT_PER_MINUTE=30
