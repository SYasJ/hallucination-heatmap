# OpenAI-compatible Chat Completions API
# Set LLM_BASE_URL to the provider's /v1 root (not /chat/completions).
LLM_BASE_URL=https://api.openai.com/v1
LLM_API_KEY=replace-me
LLM_MODEL=gpt-4o-mini

# Optional second-pass verifier. If omitted, the generation endpoint/model is reused.
# Use a different model/provider when you want a less correlated check.
# VERIFIER_BASE_URL=https://api.openai.com/v1
# VERIFIER_API_KEY=replace-me
# VERIFIER_MODEL=gpt-4o-mini

# Optional server port (default 8787)
# ANALYZER_PORT=8787
