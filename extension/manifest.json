{
  "manifest_version": 3,
  "name": "Hallucination Heatmap — Local",
  "version": "0.1.0",
  "description": "On-demand claim review for ChatGPT and Claude responses using your local Heatmap analyzer.",
  "permissions": ["activeTab"],
  "host_permissions": [
    "https://chatgpt.com/*",
    "https://claude.ai/*",
    "http://127.0.0.1:8787/*",
    "http://localhost:8787/*"
  ],
  "background": {
    "service_worker": "background.js"
  },
  "content_scripts": [
    {
      "matches": ["https://chatgpt.com/*", "https://claude.ai/*"],
      "js": ["content.js"],
      "run_at": "document_idle"
    }
  ]
}
