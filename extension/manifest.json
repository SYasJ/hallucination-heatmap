{
  "manifest_version": 3,
  "name": "Hallucination Heatmap — Local",
  "version": "0.2.0",
  "description": "On-demand claim review for ChatGPT and Claude responses using your local Hallucination Heatmap analyzer.",
  "homepage_url": "https://github.com/SYasJ/hallucination-heatmap",
  "minimum_chrome_version": "105",
  "icons": {
    "16": "icons/icon-16.png",
    "48": "icons/icon-48.png",
    "128": "icons/icon-128.png"
  },
  "host_permissions": [
    "http://127.0.0.1:8787/*",
    "http://localhost:8787/*"
  ],
  "background": {
    "service_worker": "background.js"
  },
  "content_scripts": [
    {
      "matches": ["https://chatgpt.com/*", "https://claude.ai/*"],
      "js": ["content.js"],
      "css": ["content.css"],
      "run_at": "document_idle"
    }
  ]
}
